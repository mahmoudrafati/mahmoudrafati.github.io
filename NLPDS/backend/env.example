# NLPDS Backend Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_PATH=./database/nlpds.db

# Frontend Configuration
FRONTEND_URL=https://mahmoudrafati.github.io/NLPDS

# CORS Origins (comma-separated)
CORS_ORIGINS=https://mahmoudrafati.github.io,http://localhost:8000,http://127.0.0.1:8000

# Security Configuration
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# Database Cleanup
CLEANUP_OLD_PROGRESS_DAYS=90
